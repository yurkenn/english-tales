rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Posts collection - everyone can read, authenticated users can write
    match /posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users collection - public read (for profiles), only owner can write own data
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      match /{subcollection}/{docId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Reviews collection - authenticated users can write reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Favorites collection - users can only manage their own favorites
    match /favorites/{favoriteId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.userId || favoriteId.startsWith(request.auth.uid));
      allow write: if request.auth != null && (request.auth.uid == request.resource.data.userId || favoriteId.startsWith(request.auth.uid));
      allow delete: if request.auth != null && favoriteId.startsWith(request.auth.uid);
    }

    // Global fallback - deny all other writes
    match /{collection}/{docId} {
      allow read: if true;
      allow write: if false; 
    }
  }
}
